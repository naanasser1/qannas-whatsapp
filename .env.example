# ── واتساب (من لوحة Meta for Developers) ─────────────────────────────────
# WhatsApp ← API Setup ← Phone number ID
WHATSAPP_PHONE_NUMBER_ID=

# توكن دائم من System User وليس التوكن المؤقت الذي ينتهي بعد ٢٤ ساعة
WHATSAPP_ACCESS_TOKEN=

# كلمة سر تخترعها أنت، وتضع نفسها في خانة Verify token عند إعداد الويبهوك
WHATSAPP_VERIFY_TOKEN=

# App Secret من Settings ← Basic (اضغط Show)
WHATSAPP_APP_SECRET=

# انسخ رقم النسخة من مثال curl في صفحة API Setup
GRAPH_API_VERSION=v23.0

# ── الأمان ────────────────────────────────────────────────────────────────
# أرقامك أنت فقط، بصيغة دولية بدون + وبدون مسافات، مفصولة بفاصلة
ALLOWED_NUMBERS=9665XXXXXXXX

# ── الأجينت ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# اتركه فارغاً ليستخدم النموذج الافتراضي
AGENT_MODEL=

# bypassPermissions مناسب داخل حاوية. للتشديد: dontAsk
PERMISSION_MODE=bypassPermissions
AGENT_MAX_TURNS=120
AGENT_MAX_BUDGET_USD=5

# ── التخزين ───────────────────────────────────────────────────────────────
# على Railway اربط Volume على /data وضع هذي القيمة كي تبقى الجلسات
DB_PATH=/data/state.db
AGENT_HOME=/app/agent_home
